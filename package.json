    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.8",
